# DoExam Exam client (peserta): static build served by nginx (CSR, no Node at runtime).
#   docker build -f Dockerfile.exam -t doexam-exam .
#   docker run -p 8081:8080 -e API_UPSTREAM=http://host.docker.internal:8080 doexam-exam

FROM node:22-alpine AS build
WORKDIR /src
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY . .
# shown in the footer, e.g. --build-arg APP_VERSION=$(git describe --tags --always)
ARG APP_VERSION=
ENV APP_VERSION=${APP_VERSION}
RUN npm run typecheck && npm run check:boundaries && ENTRY=exam npx vite build
RUN node scripts/check-size.mjs

FROM nginxinc/nginx-unprivileged:1.27-alpine
# where nginx forwards /api (the DoExam server)
ENV API_UPSTREAM=http://server:8080
COPY docker/nginx/security-headers.conf /etc/nginx/snippets/
COPY docker/nginx/exam.conf.template /etc/nginx/templates/default.conf.template
COPY --from=build /src/dist/exam /usr/share/nginx/html
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=3s CMD wget -qO- http://127.0.0.1:8080/healthz >/dev/null || exit 1
