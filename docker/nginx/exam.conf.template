# Exam client (participants). Static files + /api proxy. "/" goes to /exam/.
server {
    listen 8080;
    server_tokens off;
    absolute_redirect off; # keep redirects relative: the published port differs from 8080
    root /usr/share/nginx/html;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml application/manifest+json;
    gzip_min_length 1024;

    # The API has no CORS: the browser talks to this origin and nginx forwards /api to the server.
    location /api/ {
        proxy_pass ${API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
        client_max_body_size 10m;
    }

    location = /healthz { access_log off; default_type text/plain; return 200 "ok\n"; }
    location = / { return 302 /exam/; }
    # the router uses /exam (no trailing slash) as its root URL: a reload must not 404
    location = /exam { return 302 /exam/; }

    # hashed build assets never change
    location /assets/ {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # the service worker must always be revalidated so a new version is noticed
    location = /exam/sw.js {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-cache";
        add_header Service-Worker-Allowed "/exam/";
    }

    location /exam/ {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-cache";
        # strictest policy: no eval, no third-party sources (09-FRONTEND §7)
        add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; worker-src 'self'; manifest-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'" always;
        try_files $uri /exam/index.html;
    }

    location / {
        include /etc/nginx/snippets/security-headers.conf;
        try_files $uri =404;
    }
}
