{
  "name": "doexam-client",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:exam": "tsc --noEmit && ENTRY=exam vite build",
    "build:panel": "tsc --noEmit && ENTRY=panel vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check:size": "node scripts/check-size.mjs",
    "check": "npm run typecheck && npm run check:boundaries && npm run build && npm run check:size"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@tanstack/react-query": "5.105.2",
    "dompurify": "3.4.17",
    "idb": "8.0.4",
    "katex": "0.19.1",
    "lucide-react": "1.66.0",
    "qrcode-generator": "2.0.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "7.18.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.3.5"
  }
}
